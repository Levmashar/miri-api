# ──────────────────────────────────────────────────────────────
# miri-api Configuration
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# All settings have sensible defaults. The only thing you
# probably want to change is PROVIDER and API_TOKEN.
# ──────────────────────────────────────────────────────────────

# ── Provider ──────────────────────────────────────────────────
# Legacy single-provider switch, kept for older setups. Providers now run
# simultaneously (one per account) — see DEFAULT_PROVIDER below.
PROVIDER=chatgpt

# ── Browser ──────────────────────────────────────────────────
# Directory where the browser profile (cookies, login session) is stored.
# Use a separate directory per provider so sessions don't conflict.
#   ChatGPT: ./browser_data
#   Claude:  ./browser_data_claude
BROWSER_DATA_DIR=./browser_data

# Run browser without a visible window. Not recommended because
# headless mode is easily detected by anti-bot systems.
HEADLESS=false

# Playwright slow-motion delay in ms. Useful for debugging.
# Set to 0 for normal speed.
SLOW_MO=50

# ── Provider URLs ────────────────────────────────────────────
# Base URLs for each provider. You shouldn't need to change these.
CHATGPT_URL=https://chatgpt.com
CLAUDE_URL=https://claude.ai

# ── Timeouts (milliseconds) ─────────────────────────────────
# Max time to wait for the model to finish responding.
RESPONSE_TIMEOUT=120000

# Timeout per DOM selector probe when looking for UI elements.
SELECTOR_TIMEOUT=10000

# ── Human Behavior Simulation ───────────────────────────────
# Randomized delays to make browser interaction look human.
# All values in milliseconds.
TYPING_SPEED_MIN=50
TYPING_SPEED_MAX=150
THINKING_PAUSE_MIN=1000
THINKING_PAUSE_MAX=3000

# ── Logging ──────────────────────────────────────────────────
# Directory for log files.
LOG_DIR=./logs

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=DEBUG
# Admin request history persists in LOG_DIR/requests.sqlite3 across restarts.
LOG_RETENTION_DAYS=7
LOG_MAX_ENTRIES=50000

# Print logs to console in addition to log files.
VERBOSE=true

# ── API Server ───────────────────────────────────────────────
# Address and port the FastAPI server listens on.
API_HOST=0.0.0.0
API_PORT=8000

# Minimum seconds between API requests (rate limiting).
RATE_LIMIT_SECONDS=5

# Tabs per account. Each account opens this many browser tabs (shared login),
# so its requests run simultaneously without mixing up. 1 = fully serialized.
# Higher = more parallelism, but each account's own rate limits still cap it.
MAX_CONCURRENT_REQUESTS=1

# Bearer token for API authentication. Also usable as a path prefix:
#   http://host:8000/<API_TOKEN>/v1/chat/completions
# Empty string disables auth entirely (open API).
API_TOKEN=dummy123

# Origin used to build the links returned for generated media
# (response_format="url" -> http://<here>/v1/files/videos/<name>?sig=...).
# Empty = derived from each request's Host, honouring X-Forwarded-Proto/-Host.
# Set it when the gateway sits behind a reverse proxy or tunnel whose public
# address it cannot see, e.g. PUBLIC_BASE_URL=https://api.example.com
PUBLIC_BASE_URL=

# ── Providers ────────────────────────────────────────────────
# All providers (chatgpt, gemini, grok, claude) run at the same time; each
# account is assigned a provider in the admin panel. This only decides which
# provider serves a request that names none (no path prefix, unknown model).
# Providers: chatgpt, gemini, grok, claude, deepseek, qwen (text-only),
#            seedream (Dreamina, image + video only).
DEFAULT_PROVIDER=chatgpt
# Gemini image generation: try the paid "Redo with Nano Banana Pro" upgrade
# when a request asks for nano-banana-pro. On a free account it degrades to
# Nano Banana 2 automatically.
GEMINI_USE_NANO_BANANA_PRO=true

# Seedream / Dreamina (video). The default video model when a request names
# none (blank = seedance-2.0). Callers still pick per request via `model`.
SEEDREAM_DEFAULT_MODEL=
# Video generations are slow (minutes), so they get a much longer completion
# deadline than chat/image (ms). Bump this if long clips time out.
# Qwen image jobs can outlast the text response deadline.
IMAGE_RESPONSE_TIMEOUT=300000
VIDEO_RESPONSE_TIMEOUT=600000

# Slow CHAT models/modes selected in the provider UI (Gemini Deep Research /
# Deep Think, Grok DeepSearch / DeeperSearch / Heavy) run for minutes. Requests
# naming one of those models use this deadline instead of RESPONSE_TIMEOUT (ms).
LONG_MODE_TIMEOUT=900000

# ── Control plane / admin panel ──────────────────────────────
# Token for /admin and /admin/api/*. Falls back to API_TOKEN if empty.
# The control plane hard-refuses (403) if BOTH are empty. Use a SEPARATE strong
# token so callers with chat access can't add/delete accounts.
ADMIN_TOKEN=
# URL the /admin page's embedded viewer points at (blank = auto host:6080).
VNC_PUBLIC_URL=

# ── Account policy (defaults; per-account overrides live in the UI) ──
# Soft request cap per account per window: rotate to the next account of the
# same provider BEFORE hitting the hard limit. 0 = off (react to real limits).
# This is an OBSERVED-USAGE estimate, never a real remaining-quota number.
ACCOUNT_SOFT_CAP=0
ACCOUNT_SOFT_CAP_WINDOW_MIN=180
ACCOUNT_DEFAULT_COOLDOWN_MIN=60
# Overflow: how long saturation must persist before spinning up the next
# account, and how long slack must persist before draining an overflow account.
OVERFLOW_EXPAND_HOLD_S=8
OVERFLOW_SHRINK_HOLD_S=120

# ── VNC (Docker only) ────────────────────────────────────────
# Password for the noVNC browser UI at http://localhost:6080
# Used to visually access the browser for login and debugging.
#
# ⚠ CHANGE THIS. Port 6080 is published on all interfaces, and a VNC
# session grants full interactive control of a logged-in browser —
# bypassing API_TOKEN entirely. Anyone who reaches this port and knows
# this password owns your ChatGPT/Claude account.
VNC_PASSWORD=chatgpt

# Pages read the timezone directly in JS and compare it to your IP's
# region. A German exit IP reporting America/Los_Angeles is a strong
# bot signal.
#
#                      (http/https proxies only; SOCKS cannot be probed)
#   Europe/Berlin   -> an explicit IANA name (predictable; preferred)
#
# Leave as-is when connecting directly.
BROWSER_TIMEZONE=America/Los_Angeles

# Accept-Language. Separate from timezone on purpose: an English speaker
# on a German exit node is normal, so en-US is usually fine regardless.
BROWSER_LOCALE=en-US

# ── Downloads retention ──────────────────────────────────────
# Generated images and videos are multi-MB. They are deleted this many
# minutes after being written, so the downloads folder does not grow forever.
# With response_format="url" this is ALSO how long the returned link works —
# /v1/files/... starts returning 404 once the file is swept. Raise it if your
# client does not fetch the media promptly (videos take minutes to render, so
# a slow consumer can miss a 10-minute window).
# Set to 0 to keep files forever.
IMAGE_RETENTION_MINUTES=10
JANITOR_INTERVAL_SECONDS=60

# ── Extra config (live, but easy to miss) ────────────────────
# Where generated images are written.
IMAGES_DIR=./downloads/images
# How often the response-completion detector polls the page (ms).
POLL_INTERVAL_MS=300
# 1: every generation uses a verified native temporary/incognito chat.
# Missing/unsupported UI mode fails before sending; no saved-chat fallback.
# Requests may also opt in with X-Temporary-Chat: 1. Chaining saved threads is
# incompatible; send conversation context explicitly in messages instead.
TEMPORARY_CHATS=0
# 1: every generation request starts in a fresh saved chat. If TEMPORARY_CHATS
# is also enabled, that fresh chat is native temporary/incognito and is left
# after the request. Both values can also be changed live in the admin panel.
NEW_CHAT_EVERY_REQUEST=0
